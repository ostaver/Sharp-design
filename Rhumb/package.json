{
  "name": "ostarev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ostarev — site for a fictional overnight coding agent. A dithered night sky that resolves into a Delft-blue engraving at landfall. SvelteKit, OGL shaders, GSAP.",
  "scripts": {
    "dev": "vite dev --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "check": "svelte-kit sync && svelte-check"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11"
  }
}
